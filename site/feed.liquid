---
layout: null
permalink: /feed.xml
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ site.url }}/" rel="alternate"/>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <id>{{ site.url }}/</id>
  <updated>{{ build.time | date_to_xmlschema }}</updated>
  {%- assign feed_author = site.author %}
  <author>
    <name>{{ feed_author | xml_escape }}</name>
  </author>

  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ post.url }}</id>
    <content type="html">{{ post.content | strip_html | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
