<footer class="site-footer">
  <div class="wrapper">
    <div class="footer-row">
      <p class="footer-copy">
        &copy; 2007-{{ build.year }} {{ site.author | escape }}
      </p>
      <p class="footer-stamp">
        <a class="rss-link" href="/feed.xml" title="Subscribe to the feed">RSS</a>
        <span aria-hidden="true">·</span>
        <span class="last-updated">last updated {{ build.time | date: "%B %Y" }}</span>
      </p>
    </div>
  </div>
</footer>
