{% comment %}
Reusable AniList current media item component (simplified for lists).
Expects (passed via {% render %}):
  - media: The media object from AniList API
  - entry: The entry object with progress
  - progress_type: "episodes" or "chapters"
{% endcomment %}
{%- if media %}
<div class="anilist-current-item">
  <span class="anilist-current-title"><a href="https://www.anilist.co/media/{{ media.id | escape }}">{{ media.title.romaji | default: media.title.english | default: 'Unknown' | escape }}</a></span>
  <span class="anilist-current-status">{{ entry.progress | escape }} / {% if progress_type == "episodes" %}{{ media.episodes | default: '?' | escape }}{% else %}{{ media.chapters | default: '?' | escape }}{% endif %}</span>
</div>
{%- endif -%}
