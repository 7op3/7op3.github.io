{% comment %}
Reusable AniList current media item component (simplified for lists).
Expects (passed via {% render %}):
  - media: The media object from AniList API
  - entry: The entry object with progress
  - progress_type: "episodes" or "chapters"
{% endcomment %}

{% if media %}
<div class="anilist-current-item">
  <span class="anilist-current-title"><a href="https://www.anilist.co/media/{{ media.id }}">{{ media.title.romaji | default: media.title.english | default: 'Unknown' }}</a></span>
  <span class="anilist-current-status">{{ entry.progress }} / {% if progress_type == "episodes" %}{{ media.episodes | default: '?' }}{% else %}{{ media.chapters | default: '?' }}{% endif %}</span>
</div>
{% endif %}
